{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/src"
      ],
      "cppStandard": "c++20",
      "defines": [
        "DEBUGX=1",
        "__AVX2__=1",
        "__BMI2__=1"
      ],
      "configurationProvider": "ms-vscode.makefile-tools",
      "cStandard": "c17",
      "compilerPath": "/usr/bin/gcc",
      "intelliSenseMode": "linux-gcc-x64"
    },
    {
      "name": "mac-clang-arm64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/src"
      ],
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "cppStandard": "c++20",
      "cStandard": "c17",
      "compilerPath": "/usr/bin/clang++",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ],
  "version": 4
}
