{
    // One launch and one attach per platform: gdb on Linux, CodeLLDB on macOS, the Visual Studio debugger on Windows
    // (clang there targets the MSVC ABI and writes a .pdb). Each launch builds the engine first ("build pawnstar").
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linux: Launch pawnstar (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pawnstar",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build pawnstar",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set hex output",
                    "text": "set output-radix 16",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Linux: Attach to pawnstar (gdb)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/pawnstar",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set hex output",
                    "text": "set output-radix 16",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "macOS: Launch pawnstar (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/pawnstar",
            "cwd": "${workspaceFolder}",
            "args": [],
            "terminal": "integrated",
            "preLaunchTask": "build pawnstar"
        },
        {
            "name": "macOS: Attach to pawnstar (lldb)",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/build/pawnstar"
        },
        {
            "name": "Windows: Launch pawnstar (Visual Studio debugger)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pawnstar.exe",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "build pawnstar"
        },
        {
            "name": "Windows: Attach to pawnstar (Visual Studio debugger)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
