# The engine's version, MAJOR.MINOR.BUILD, from git alone - the rule every reckless-technology project follows (the
# plugins' and IR Capture's CMake, pawnstar-rs's build.rs, pawnstar-go's tools/version.sh). MAJOR.MINOR is the nearest
# annotated tag vMAJOR.MINOR reachable from HEAD, made by hand on main; BUILD is the number of commits since it, the
# tagged commit itself being 0. The release workflow's own three-component tags (vMAJOR.MINOR.BUILD) are excluded, so
# nothing in the tree is edited to release: tag main vMAJOR.MINOR and push the tag.
#
# A tree with no such tag reachable - a source tarball, a shallow clone, a fork without the tags - builds as 0.0.0 with
# a warning, which the release workflow refuses. Sets PAWNSTAR_VERSION and writes it into one generated header,
# force-included into main.cpp alone (version.h reads PAWNSTAR_VERSION_STRING), rewritten only when the number changes,
# so a new commit recompiles that one translation unit. The configure runs again by itself when HEAD moves (a commit, a
# checkout); after a new tag, reconfigure by hand (the release builds from nothing).
include_guard(GLOBAL)

find_package(Git QUIET)
set(_pawnstar_describe "")
set(_pawnstar_describe_rc 1)
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" describe --tags --long
            --match "v[0-9]*.[0-9]*" --exclude "v*.*.*"
    OUTPUT_VARIABLE _pawnstar_describe
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _pawnstar_describe_rc
    ERROR_QUIET)
endif()
if(_pawnstar_describe_rc EQUAL 0 AND _pawnstar_describe MATCHES "^v([0-9]+)\\.([0-9]+)-([0-9]+)-g[0-9a-f]+$")
  set(PAWNSTAR_VERSION "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_3}")
else()
  message(WARNING "No vMAJOR.MINOR tag is reachable from HEAD (git describe said '${_pawnstar_describe}'): the "
                  "engine reports 0.0.0. Fetch the tags (git fetch --tags; CI checks out with fetch-depth 0).")
  set(PAWNSTAR_VERSION "0.0.0")
endif()
message(STATUS "Pawnstar ${PAWNSTAR_VERSION}")

set(PAWNSTAR_VERSION_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated/pawnstar_version.h")
file(CONFIGURE OUTPUT "${PAWNSTAR_VERSION_HEADER}" CONTENT [[
// Generated by cmake/version.cmake from the git tags - do not edit, do not commit.
#pragma once
#define PAWNSTAR_VERSION_STRING "@PAWNSTAR_VERSION@"
]] @ONLY)

# Configure again when HEAD moves: a commit or a checkout writes logs/HEAD, a branch switch HEAD, a gc packed-refs.
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse --absolute-git-dir
    OUTPUT_VARIABLE _pawnstar_git_dir
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(_pawnstar_git_dir)
    foreach(_ref HEAD logs/HEAD packed-refs)
      if(EXISTS "${_pawnstar_git_dir}/${_ref}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pawnstar_git_dir}/${_ref}")
      endif()
    endforeach()
  endif()
endif()
